<TrialConfig>
  <HomePosition>
    <Position x="0.0" y="0.0" z="0.0"/>
    <Tolerance>0.01</Tolerance>
  </HomePosition>

  <EndConditions>
    <Condition name="time" success="false" priority="0">
      <Parameters duration_seconds="10.0"/>
    </Condition>
  </EndConditions>

  <HUDText>
    <StartMessage>Testing configurable data collection</StartMessage>
    <SuccessMessage>Success!</SuccessMessage>
    <FailureMessage>Try again.</FailureMessage>
  </HUDText>

  <SceneSettings>
    <BackgroundColor r="0.2" g="0.2" b="0.2"/>
    <Camera>
      <Position x="0.0" y="0.0" z="0.5"/>
      <LookAt x="0.0" y="0.0" z="0.0"/>
      <Up x="0.0" y="1.0" z="0.0"/>
    </Camera>
  </SceneSettings>

  <!-- Configurable Data Collection -->
  <!-- Set enabled="true" for fields you want, "false" to skip -->
  <DataCollection>
    <Device>
      <Position enabled="true"/>
      <Velocity enabled="false"/>
      <AngularVelocity enabled="false"/>
      <Orientation enabled="false"/>
      <ProxyPosition enabled="false"/>
      <Force enabled="false"/>
    </Device>

    <Objects>
      <Position enabled="false"/>
      <Orientation enabled="false"/>
      <Contact enabled="false"/>
      <ContactPoint enabled="false"/>
      <ContactNormal enabled="false"/>
      <PenetrationDepth enabled="false"/>
      <Force enabled="false"/>
      <SpringForce enabled="false"/>
      <DampingForce enabled="false"/>
    </Objects>
  </DataCollection>

  <Objects>
    <Object id="spring1" type="spring">
      <Position x="0.0" y="0.3" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="1.0" b="0.0"/>
      <Parameters radius="0.08" height="0.20" stiffness="1000.0" damping="100.0"/>
    </Object>

    <Object id="target" type="sphere">
      <Position x="0.0" y="-0.3" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.0" g="1.0" b="0.0"/>
      <Parameters radius="0.05"/>
    </Object>
  </Objects>
</TrialConfig>

