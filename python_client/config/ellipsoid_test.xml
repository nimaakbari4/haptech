<?xml version="1.0" encoding="UTF-8"?>
<TrialConfig>
  <!-- Test configuration for ellipsoid objects -->

  <StartConditions>
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="0.0"/>
    </Condition>
  </StartConditions>

  <EndConditions>
    <!-- Give plenty of time to explore ellipsoid objects -->
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="60.0"/>
    </Condition>
  </EndConditions>

  <HUDText>
    <StartMessage>Test ellipsoid objects! Explore different ellipsoid shapes and sizes.</StartMessage>
    <SuccessMessage>Great exploration of ellipsoids!</SuccessMessage>
    <FailureMessage>Time's up! You can restart to continue exploring.</FailureMessage>
  </HUDText>

  <SceneSettings>
    <BackgroundColor r="0.1" g="0.1" b="0.15"/>
    <Camera>
      <Position x="1.2" y="1.2" z="1.5"/>
      <LookAt x="0.0" y="0.0" z="0.0"/>
      <Up x="0.0" y="0.0" z="1.0"/>
    </Camera>
  </SceneSettings>

  <Controls>
    <MouseCursor>true</MouseCursor>
  </Controls>

  <Objects>
    <!-- ===== ELLIPSOID OBJECTS ===== -->
    <!-- Sphere-like ellipsoid (all radii equal) -->
    <Object id="sphere_ellipsoid" type="ellipsoid">
      <Position x="0.0" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="0.0" b="0.0"/>
      <Parameters radius_x="0.05" radius_y="0.05" radius_z="0.05" slices="32" stacks="16"/>
    </Object>

    <!-- Prolate ellipsoid (elongated along Z-axis) -->
    <Object id="prolate_ellipsoid" type="ellipsoid">
      <Position x="0.2" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.0" g="1.0" b="0.0"/>
      <Parameters radius_x="0.03" radius_y="0.03" radius_z="0.08" slices="32" stacks="20"/>
    </Object>

    <!-- Oblate ellipsoid (flattened along Z-axis) -->
    <Object id="oblate_ellipsoid" type="ellipsoid">
      <Position x="-0.2" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.0" g="0.0" b="1.0"/>
      <Parameters radius_x="0.06" radius_y="0.06" radius_z="0.02" slices="32" stacks="12"/>
    </Object>

    <!-- Triaxial ellipsoid (all radii different) -->
    <Object id="triaxial_ellipsoid" type="ellipsoid">
      <Position x="0.0" y="0.2" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="1.0" b="0.0"/>
      <Parameters radius_x="0.08" radius_y="0.04" radius_z="0.06" slices="40" stacks="20"/>
    </Object>

    <!-- Very elongated ellipsoid (like a capsule) -->
    <Object id="capsule_ellipsoid" type="ellipsoid">
      <Position x="0.0" y="-0.2" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="0.0" b="1.0"/>
      <Parameters radius_x="0.02" radius_y="0.02" radius_z="0.12" slices="24" stacks="24"/>
    </Object>

    <!-- Flat pancake ellipsoid -->
    <Object id="pancake_ellipsoid" type="ellipsoid">
      <Position x="0.2" y="0.2" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.0" g="1.0" b="1.0"/>
      <Parameters radius_x="0.08" radius_y="0.08" radius_z="0.01" slices="32" stacks="8"/>
    </Object>

    <!-- High-quality ellipsoid -->
    <Object id="high_quality_ellipsoid" type="ellipsoid">
      <Position x="-0.2" y="0.2" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="0.5" b="0.0"/>
      <Parameters radius_x="0.05" radius_y="0.07" radius_z="0.04" slices="64" stacks="32"/>
    </Object>

    <!-- Low-quality ellipsoid (for performance comparison) -->
    <Object id="low_quality_ellipsoid" type="ellipsoid">
      <Position x="-0.2" y="-0.2" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.5" g="0.5" b="0.5"/>
      <Parameters radius_x="0.04" radius_y="0.06" radius_z="0.03" slices="8" stacks="6"/>
    </Object>

    <!-- Tiny ellipsoid -->
    <Object id="tiny_ellipsoid" type="ellipsoid">
      <Position x="0.15" y="-0.15" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.8" g="0.8" b="0.8"/>
      <Parameters radius_x="0.01" radius_y="0.015" radius_z="0.02" slices="16" stacks="12"/>
    </Object>

    <!-- Large ellipsoid -->
    <Object id="large_ellipsoid" type="ellipsoid">
      <Position x="0.0" y="0.0" z="0.2"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.3" g="0.7" b="0.3"/>
      <Parameters radius_x="0.1" radius_y="0.08" radius_z="0.06" slices="48" stacks="24"/>
    </Object>

    <!-- ===== REFERENCE OBJECTS ===== -->
    <!-- Floor plane -->
    <Object id="floor" type="cylinder">
      <Position x="0.0" y="0.0" z="-0.15"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.3" g="0.3" b="0.3"/>
      <Parameters radius="0.8" height="0.005"/>
    </Object>

    <!-- Central reference post -->
    <Object id="center_post" type="cylinder">
      <Position x="0.0" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.5" g="0.5" b="0.5"/>
      <Parameters radius="0.005" height="0.3"/>
    </Object>

    <!-- Corner markers -->
    <Object id="corner1" type="sphere">
      <Position x="0.4" y="0.4" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.4" g="0.4" b="0.4"/>
      <Parameters radius="0.01"/>
    </Object>

    <Object id="corner2" type="sphere">
      <Position x="-0.4" y="0.4" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.4" g="0.4" b="0.4"/>
      <Parameters radius="0.01"/>
    </Object>

    <Object id="corner3" type="sphere">
      <Position x="0.4" y="-0.4" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.4" g="0.4" b="0.4"/>
      <Parameters radius="0.01"/>
    </Object>

    <Object id="corner4" type="sphere">
      <Position x="-0.4" y="-0.4" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.4" g="0.4" b="0.4"/>
      <Parameters radius="0.01"/>
    </Object>

  </Objects>
</TrialConfig>
