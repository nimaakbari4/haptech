<TrialConfig>
  <Test>false</Test>
  <StartConditions>
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="0.0"/>
    </Condition>
  </StartConditions>
  <EndConditions>
    <Condition name="nima_reaching" success="true" priority="1">
      <Parameters repetitions="1" axis_sign="1" distance_m="0.25" free_reach="1"
        min_time_s="0.900" max_time_s="1.100" onset_m_s="0.03" onset_confirm_s="0.020"
        target_hold_s="0.15" feedback_s="2.5" return_speed_factor="0.1"
        channel_k_n_m="300" depth_k_n_m="600" channel_b_ns_m="12" max_force_n="8" force_slew_n_s="40" target_k_n_m="300"/>
    </Condition>
  </EndConditions>
  <SceneSettings>
    <BackgroundColor r="30" g="45" b="60"/>
    <Camera>
      <Position x="1.5" y="0.4" z="0"/>
      <LookAt x="0" y="0.4" z="0"/>
      <Up x="0" y="0" z="1"/>
    </Camera>
    <TextOverlay>
      <Text>After GO, reach GREEN to RED. Allow robot to return.</Text>
      <X>10</X><Y>50</Y><FontSize>20</FontSize><Color r="255" g="255" b="255"/>
    </TextOverlay>
  </SceneSettings>
  <DataCollection>
    <Device>
      <Position enabled="true"/><Velocity enabled="true"/><AngularVelocity enabled="true"/>
      <Orientation enabled="true"/><ProxyPosition enabled="true"/><Force enabled="true"/>
    </Device>
    <Objects>
      <Position enabled="true"/><Orientation enabled="true"/><Contact enabled="false"/>
      <ContactPoint enabled="false"/><ContactNormal enabled="false"/><PenetrationDepth enabled="false"/>
    </Objects>
  </DataCollection>
  <Objects>
    <!-- Dedicated task meshes start far from the handle; the task places/scales them after initial return. -->
    <Object id="nima_home" type="box">
      <Position x="0" y="5" z="0"/><Orientation x="0" y="0" z="0"/>
      <Parameters width="0.02" height="0.012" depth="0.02"/>
      <Color r="0" g="1" b="0"/>
    </Object>
    <Object id="nima_target" type="box">
      <Position x="0" y="6" z="0"/><Orientation x="0" y="0" z="0"/>
      <Parameters width="0.02" height="0.02" depth="0.02"/>
      <Color r="1" g="0" b="0"/>
    </Object>
  </Objects>
</TrialConfig>
