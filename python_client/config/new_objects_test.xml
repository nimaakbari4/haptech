<?xml version="1.0" encoding="UTF-8"?>
<TrialConfig>
  <!-- Test configuration for newly added object types -->
  
  <HomePosition>
    <Position x="0.0" y="0.0" z="0.0"/>
    <Tolerance>0.02</Tolerance>
  </HomePosition>

  <StartConditions>
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="0.0"/>
    </Condition>
  </StartConditions>

  <EndConditions>
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="120.0"/>
    </Condition>
    <Condition name="velocity" success="false" priority="1">
      <Parameters max_velocity="2"/>
    </Condition>
  </EndConditions>

  <HUDText>
    <StartMessage>Test new object types! Currently testing: Torus objects with different configurations.</StartMessage>
    <SuccessMessage>New objects tested successfully!</SuccessMessage>
    <FailureMessage>Testing time complete.</FailureMessage>
  </HUDText>

  <SceneSettings>
    <BackgroundColor r="0.15" g="0.15" b="0.2"/>
    <Camera>
      <Position x="1.0" y="1.0" z="1.2"/>
      <LookAt x="0.0" y="0.0" z="0.0"/>
      <Up x="0.0" y="0.0" z="1.0"/>
    </Camera>
  </SceneSettings>

  <Controls>
    <MouseCursor>true</MouseCursor>
  </Controls>

  <Objects>
    <!-- ===== TORUS OBJECTS ===== -->
    
    <!-- Basic torus - medium size -->
    <Object id="basic_torus" type="torus">
      <Position x="0.0" y="0.15" z="0.0"/>
      <Orientation x="0" y="90" z="0"/>
      <Color r="0.0" g="0.8" b="0.2"/>
      <Parameters inner_radius="0.025" outer_radius="0.055"/>
    </Object>

    <!-- Small thin torus (like a ring) -->
    <Object id="thin_ring" type="torus">
      <Position x="0.15" y="0.0" z="0.0"/>
      <Orientation x="0" y="0" z="45"/>
      <Color r="1.0" g="0.8" b="0.0"/>
      <Parameters inner_radius="0.035" outer_radius="0.04" num_sides="12" num_rings="16"/>
    </Object>

    <!-- Thick torus (more like a donut) -->
    <Object id="thick_donut" type="torus">
      <Position x="-0.15" y="0.0" z="0.0"/>
      <Orientation x="45" y="45" z="0"/>
      <Color r="0.8" g="0.2" b="0.8"/>
      <Parameters inner_radius="0.02" outer_radius="0.07" num_sides="20" num_rings="24"/>
    </Object>

    <!-- ===== REFERENCE OBJECTS ===== -->
    
    <!-- Floor reference (thin cylinder) -->
    <Object id="floor_ref" type="cylinder">
      <Position x="0.0" y="0.0" z="-0.08"/>
      <Orientation x="0" y="0" z="0"/>
      <Color r="0.25" g="0.25" b="0.25"/>
      <Parameters radius="0.4" height="0.002"/>
    </Object>

    <!-- Center reference post -->
    <Object id="center_ref" type="sphere">
      <Position x="0.0" y="0.0" z="0.0"/>
      <Orientation x="0" y="0" z="0"/>
      <Color r="0.4" g="0.4" b="0.4"/>
      <Parameters radius="0.005"/>
    </Object>

  </Objects>
</TrialConfig>