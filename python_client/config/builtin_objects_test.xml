<?xml version="1.0" encoding="UTF-8"?>
<TrialConfig>
  <!-- Test configuration for all built-in object types (sphere, box, cylinder, ball) -->

  <StartConditions>
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="0.0"/>
    </Condition>
  </StartConditions>

  <EndConditions>
    <!-- Give plenty of time to explore all objects -->
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="60.0"/>
    </Condition>
  </EndConditions>

  <HUDText>
    <StartMessage>Test all built-in object types! Explore the sphere, box, cylinder, ball, and torus.</StartMessage>
    <SuccessMessage>Great exploration!</SuccessMessage>
    <FailureMessage>Time's up! You can restart to continue exploring.</FailureMessage>
  </HUDText>

  <SceneSettings>
    <BackgroundColor r="0.1" g="0.1" b="0.15"/>
    <Camera>
      <Position x="1.2" y="1.2" z="1.5"/>
      <LookAt x="0.0" y="0.0" z="0.0"/>
      <Up x="0.0" y="0.0" z="1.0"/>
    </Camera>
  </SceneSettings>

  <Controls>
    <MouseCursor>true</MouseCursor>
  </Controls>

  <Objects>
    <!-- ===== SPHERE OBJECTS ===== -->
    <!-- Small red sphere -->
    <Object id="small_sphere" type="sphere">
      <Position x="0.15" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="0.0" b="0.0"/>
      <Parameters radius="0.03"/>
    </Object>

    <!-- Medium blue sphere -->
    <Object id="medium_sphere" type="sphere">
      <Position x="0.3" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.0" g="0.3" b="1.0"/>
      <Parameters radius="0.05"/>
    </Object>

    <!-- Large green sphere -->
    <Object id="large_sphere" type="sphere">
      <Position x="0.45" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.0" g="0.8" b="0.2"/>
      <Parameters radius="0.07"/>
    </Object>

    <!-- ===== BOX OBJECTS ===== -->
    <!-- Small cube -->
    <Object id="small_cube" type="box">
      <Position x="0.0" y="0.15" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="0.5" b="0.0"/>
      <Parameters width="0.04" height="0.04" depth="0.04"/>
    </Object>

    <!-- Rectangular box -->
    <Object id="rect_box" type="box">
      <Position x="0.0" y="0.3" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.8" g="0.0" b="0.8"/>
      <Parameters width="0.08" height="0.04" depth="0.02"/>
    </Object>

    <!-- Tall thin box -->
    <Object id="tall_box" type="box">
      <Position x="0.0" y="0.45" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.2" g="0.8" b="0.8"/>
      <Parameters width="0.02" height="0.02" depth="0.12"/>
    </Object>

    <!-- ===== CYLINDER OBJECTS ===== -->
    <!-- Short wide cylinder -->
    <Object id="short_cylinder" type="cylinder">
      <Position x="-0.15" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.9" g="0.9" b="0.1"/>
      <Parameters radius="0.06" height="0.02"/>
    </Object>

    <!-- Medium cylinder -->
    <Object id="medium_cylinder" type="cylinder">
      <Position x="-0.3" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.1" g="0.9" b="0.1"/>
      <Parameters radius="0.04" height="0.08"/>
    </Object>

    <!-- Tall thin cylinder -->
    <Object id="tall_cylinder" type="cylinder">
      <Position x="-0.45" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.6" g="0.3" b="0.9"/>
      <Parameters radius="0.02" height="0.15"/>
    </Object>

    <!-- ===== BALL OBJECTS (with different bounciness) ===== -->
    <!-- Very bouncy ball -->
    <Object id="bouncy_ball" type="ball">
      <Position x="0.0" y="-0.15" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="0.1" b="0.1"/>
      <Parameters radius="0.04" bounciness="0.9"/>
    </Object>

    <!-- Medium bouncy ball -->
    <Object id="medium_bouncy_ball" type="ball">
      <Position x="0.0" y="-0.3" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.1" g="1.0" b="0.1"/>
      <Parameters radius="0.04" bounciness="0.5"/>
    </Object>

    <!-- Low bouncy ball (more damped) -->
    <Object id="damped_ball" type="ball">
      <Position x="0.0" y="-0.45" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.1" g="0.1" b="1.0"/>
      <Parameters radius="0.04" bounciness="0.1"/>
    </Object>

    <!-- ===== TORUS OBJECTS ===== -->
    <!-- Small torus -->
    <Object id="small_torus" type="torus">
      <Position x="0.15" y="-0.15" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="0.5" b="0.0"/>
      <Parameters inner_radius="0.015" outer_radius="0.04" num_sides="12" num_rings="16"/>
    </Object>

    <!-- Medium torus -->
    <Object id="medium_torus" type="torus">
      <Position x="0.3" y="-0.15" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.5" g="0.0" b="1.0"/>
      <Parameters inner_radius="0.03" outer_radius="0.06" num_sides="16" num_rings="20"/>
    </Object>

    <!-- Large high-quality torus -->
    <Object id="large_torus" type="torus">
      <Position x="0.45" y="-0.15" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.0" g="0.8" b="0.5"/>
      <Parameters inner_radius="0.04" outer_radius="0.08" num_sides="24" num_rings="32"/>
    </Object>

    <!-- Thin torus (like a ring) -->
    <Object id="thin_torus" type="torus">
      <Position x="-0.15" y="-0.15" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.9" g="0.9" b="0.1"/>
      <Parameters inner_radius="0.05" outer_radius="0.055" num_sides="16" num_rings="24"/>
    </Object>

    <!-- ===== MIXED SIZES FOR COMPARISON ===== -->
    <!-- Tiny objects cluster -->
    <Object id="tiny_sphere" type="sphere">
      <Position x="0.2" y="0.2" z="0.05"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="0.8" b="0.8"/>
      <Parameters radius="0.015"/>
    </Object>

    <Object id="tiny_cube" type="box">
      <Position x="0.22" y="0.22" z="0.05"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.8" g="1.0" b="0.8"/>
      <Parameters width="0.025" height="0.025" depth="0.025"/>
    </Object>

    <Object id="tiny_cylinder" type="cylinder">
      <Position x="0.18" y="0.24" z="0.05"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.8" g="0.8" b="1.0"/>
      <Parameters radius="0.015" height="0.03"/>
    </Object>

    <Object id="tiny_ball" type="ball">
      <Position x="0.24" y="0.18" z="0.05"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="1.0" g="1.0" b="0.8"/>
      <Parameters radius="0.015" bounciness="0.8"/>
    </Object>

    <!-- ===== BOUNDARY/REFERENCE OBJECTS ===== -->
    <!-- Floor plane (very flat cylinder) -->
    <Object id="floor" type="cylinder">
      <Position x="0.0" y="0.0" z="-0.1"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.3" g="0.3" b="0.3"/>
      <Parameters radius="0.8" height="0.005"/>
    </Object>

    <!-- Central reference post -->
    <Object id="center_post" type="cylinder">
      <Position x="0.0" y="0.0" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.5" g="0.5" b="0.5"/>
      <Parameters radius="0.005" height="0.2"/>
    </Object>

    <!-- Corner markers (small spheres) -->
    <Object id="corner1" type="sphere">
      <Position x="0.5" y="0.5" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.4" g="0.4" b="0.4"/>
      <Parameters radius="0.01"/>
    </Object>

    <Object id="corner2" type="sphere">
      <Position x="-0.5" y="0.5" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.4" g="0.4" b="0.4"/>
      <Parameters radius="0.01"/>
    </Object>

    <Object id="corner3" type="sphere">
      <Position x="0.5" y="-0.5" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.4" g="0.4" b="0.4"/>
      <Parameters radius="0.01"/>
    </Object>

    <Object id="corner4" type="sphere">
      <Position x="-0.5" y="-0.5" z="0.0"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.4" g="0.4" b="0.4"/>
      <Parameters radius="0.01"/>
    </Object>

  </Objects>
</TrialConfig>