<TrialConfig>
  <Test>true</Test>
  <StartConditions>
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="0.0"/>
    </Condition>
  </StartConditions>

  <EndConditions>
    <Condition name="position" success="true" priority="1">
        <Parameters target_x="0.0" target_y="0.0" target_z="-0.2" tolerance="0.1"/>
    </Condition>
  </EndConditions>

  <HUDText>
    <StartMessage>Move to the target position (0, 0.5, 0) to complete the trial!</StartMessage>
    <SuccessMessage>Great! You reached the target position!</SuccessMessage>
    <FailureMessage>You didn't reach the target position.</FailureMessage>
  </HUDText>

  <SceneSettings>
    <BackgroundColor r="106" g="137" b="167"/>
    <Camera>
      <Position x="1.0" y="0.0" z="0.0"/>
      <LookAt x="0.0" y="0.0" z="0.0"/>
      <Up x="0.0" y="0.0" z="1.0"/>
    </Camera>
    <TextOverlay>
      <Text>Move to the indicator box to begin the next trial.</Text>
      <X>400</X>
      <Y>0</Y>
      <FontSize>32</FontSize>
      <Color r="0" g="128" b="0"/>
    </TextOverlay>
  </SceneSettings>

  <Controls>
    <MouseCursor>true</MouseCursor>
  </Controls>

  <!-- Collect everything: all device and per-object data enabled -->
  <DataCollection>
    <Device>
      <Position enabled="true"/>
      <Velocity enabled="true"/>
      <AngularVelocity enabled="true"/>
      <Orientation enabled="true"/>
      <ProxyPosition enabled="true"/>
      <Force enabled="true"/>
    </Device>
    <Objects>
      <Position enabled="true"/>
      <Orientation enabled="true"/>
      <Contact enabled="true"/>
      <ContactPoint enabled="true"/>
      <ContactNormal enabled="true"/>
      <PenetrationDepth enabled="true"/>pushable_ball_test.
      <Force enabled="true"/>
      <SpringForce enabled="true"/>
      <DampingForce enabled="true"/>
    </Objects>
  </DataCollection>

  <Objects>
    <Object id="home_indicator" type="box">
      <Position x="0.0" y="0.0" z="-0.2"/>
      <Orientation x="0" y="0" z="0"/>
      <Parameters width="0.1" height="0.1" depth="0.1"/>
      <Color r="0.0" g="1.0" b="0.0"/>
    </Object>
  </Objects>
</TrialConfig>
