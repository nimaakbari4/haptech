<TrialConfig>
  <StartConditions>
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="5.0"/>
    </Condition>
  </StartConditions>

  <EndConditions>
    <Condition name="time" success="true" priority="1">
      <Parameters duration_seconds="60.0"/>
    </Condition>
  </EndConditions>

  <HUDText>
    <StartMessage>Test the researcher's custom objects!</StartMessage>
    <SuccessMessage>Great job!</SuccessMessage>
    <FailureMessage>Time's up. Try again!</FailureMessage>
  </HUDText>

  <SceneSettings>
    <BackgroundColor r="0.2" g="0.2" b="0.2"/>
    <Camera>
      <Position x="1.0" y="1.0" z="2.0"/>
      <LookAt x="0.0" y="0.0" z="0.0"/>
      <Up x="0.0" y="1.0" z="0.0"/>
    </Camera>
  </SceneSettings>

  <Controls>
    <MouseCursor>true</MouseCursor>
  </Controls>

  <CursorSettings object="spring">
    <Parameters radius="0.02" height="0.12" stiffness="1000" damping="50" />
    <Color r="0.8" g="0.8" b="0.0" />
  </CursorSettings>

  <Objects>
    <!-- Regular sphere for comparison - Bright Green (Left) -->
    <Object id="regular_sphere" type="sphere">
      <Position x="0.0" y="-0.5" z="0.0"/>
      <Orientation x="0" y="0" z="0"/>
      <Color r="1.0" g="0.0" b="0.0"/>
      <Parameters radius="0.06"/>
    </Object>

    <Object id="big_box" type="box">
      <Position x="0.05" y="0.05" z="0.2"/>
      <Orientation x="0" y="0" z="10"/>
      <Color r="0.0" g="1.0" b="0.0"/>
      <Parameters width="0.5" height="0.2" depth="0.2"/>
    </Object>    

    <Object id="cylinder1" type="cylinder">
      <Position x="0.0" y="0.5" z="0.0"/>
      <Orientation x="20" y="30" z="10"/>
      <Color r="1.0" g="1.0" b="0.0"/>
      <Parameters radius="0.08" height="0.20"/>
    </Object>

    <Object id="goal" type="box">
      <Position x="0.0" y="0.2" z="0.0"/>
      <Orientation x="0" y="0" z="0"/>
      <Parameters width="0.02" height="0.02" depth="0.02"/>
      <Color r="0.0" g="1.0" b="0.0"/>
    </Object>
  </Objects>
</TrialConfig>
