<?xml version="1.0" encoding="UTF-8"?>
<TrialConfig>
  <!-- F4.1.1: Trial Home Position -->
  <HomePosition>
    <Position x="0.0" y="0.0" z="0.0"/>
    <Tolerance>0.01</Tolerance>
  </HomePosition>

  <!-- F4.1.2: Trial End Conditions -->
  <EndConditions>
    <Condition name="reach_target" success="true" priority="1">
      <Parameters target_distance="0.02" />
    </Condition>
    <Condition name="time_limit" success="false" priority="2">
      <Parameters max_time="30.0" />
    </Condition>
  </EndConditions>

  <!-- F4.1.3: HUD Text -->
  <HUDText>
    <StartMessage>Move the cursor to the target as quickly and accurately as possible.</StartMessage>
    <SuccessMessage>Well done! You reached the target.</SuccessMessage>
    <FailureMessage>Time's up! Try again.</FailureMessage>
  </HUDText>

  <!-- F4.1.4: Scene Settings -->
  <SceneSettings>
    <BackgroundColor r="0.2" g="0.2" b="0.2" />
    <Camera>
      <Position x="1.0" y="1.0" z="2.0"/>
      <LookAt x="0.0" y="0.0" z="0.0"/>
      <Up x="0.0" y="1.0" z="0.0"/>
    </Camera>
  </SceneSettings>

  <!-- Cursor Settings -->
  <CursorSettings object="spring">
    <!-- Optional: spring parameters (match SpringObject: radius, height, stiffness, damping) -->
    <Parameters radius="0.02" height="0.12" stiffness="1000" damping="50" />
    <Color r="0.8" g="0.8" b="0.0" />
  </CursorSettings>

  <!-- F4.1.5: Scene Objects -->
  <Objects>
    <Object id="target" type="sphere">
      <Position x="0.1" y="0.2" z="0.3"/>
      <Orientation roll="0" pitch="0" yaw="0"/>
      <Color r="0.0" g="1.0" b="0.0"/>
      <Parameters radius="0.02"/>
    </Object>

    <Object id="boundary" type="cylinder">
      <Position x="0.0" y="0.0" z="0.0"/>
      <Orientation roll="90" pitch="0" yaw="0"/>
      <Parameters radius="0.5" height="0.01"/>
      <Color r="0.5" g="0.5" b="0.5"/>
    </Object>
  </Objects>

  <!-- Data Collection Configuration -->
  <DataCollection>
    <Device>
      <Position enabled="true"/>
      <Velocity enabled="true"/>
      <Force enabled="true"/>
    </Device>
    <Objects>
      <Position enabled="true"/>
      <Contact enabled="true"/>
      <Force enabled="true"/>
    </Objects>
  </DataCollection>
</TrialConfig>